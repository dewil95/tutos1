{
  "name": "@mca/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./vitest-wasm": {
      "types": "./vitest-wasm.ts",
      "default": "./vitest-wasm.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
