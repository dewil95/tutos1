    "schema:sql": "node scripts/schema-sql.mjs"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "miniflare": "^4.20260730.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
