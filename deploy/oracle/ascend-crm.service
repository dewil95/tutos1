[Unit]
Description=Ascend CRM (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=ascend
Group=ascend
WorkingDirectory=/opt/ascend-crm/apps/web/.next/standalone/apps/web
Environment=NODE_ENV=production
Environment=PORT=3000
# Only this server can reach it; the public site comes in through the Cloudflare Tunnel.
Environment=HOSTNAME=127.0.0.1
Environment=DATABASE_PATH=/var/lib/ascend-crm/crm.db
EnvironmentFile=/etc/ascend-crm/env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/ascend-crm /opt/ascend-crm/apps/web/.next

[Install]
WantedBy=multi-user.target
