# Ascend CRM server settings: /etc/ascend-crm/env (readable only by root and the app).
# Edit with: sudo nano /etc/ascend-crm/env    Apply with: sudo systemctl restart ascend-crm
# Never paste these values into a chat or an email.

# --- Plain settings ------------------------------------------------------------
APP_URL=https://crm.ascendfund.co
ALLOWED_EMAIL_DOMAIN=ascendfund.co
TENANT_SLUG=ascend
# Lender emails only really go out when this is "false". Keep "true" until test deals look right.
MCA_EMAIL_DRY_RUN=true
# Emails to merchants (missing documents, stip chases, signing links) only go out when this is
# "on" as well; otherwise they are only written to the deal timeline.
MERCHANT_EMAILS=off
WHATSAPP_ENABLED=false

# --- Sign-in: Cloudflare Access (Zero Trust → Access → Applications → Ascend CRM) ------
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# --- Or the CRM's own "Sign in with Google" (no domain on Cloudflare; see public-https.sh) ---
# Signs the sign-in cookie. Set by public-https.sh; changing it signs everyone out.
# openssl rand -hex 32
SESSION_SECRET=

# --- Google Workspace (Gmail + Drive for funding@, read-only history for jonas@) -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (Gemini key from a billing-enabled Google Cloud project) ------------------
GEMINI_API_KEY=

# --- Secrets the CRM needs --------------------------------------------------------
# Encrypts SSN/DOB/EIN and the Google connections. KEEP A COPY in your password manager:
# without it the saved SSNs and Google connections cannot be read. openssl rand -base64 32
PII_ENCRYPTION_KEY=
# Protects the background-job route. openssl rand -hex 32
CRON_SECRET=

# --- Backups: Oracle Object Storage (S3-compatible) ---------------------------------
# Bucket: Storage → Buckets → Create ("ascend-crm-backups", private).
# Keys: Profile → Customer secret keys → Generate (the secret is shown once).
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   (namespace: Tenancy details → Object storage namespace; region e.g. us-ashburn-1)
BACKUP_BUCKET=ascend-crm-backups
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
