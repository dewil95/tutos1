{
  "name": "mca-crm",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native CRM for Merchant Cash Advance brokers (Next.js on Vercel, Supabase, Google Workspace, Gemini API)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mca/db generate",
    "db:migrate": "pnpm --filter @mca/db migrate:dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml,css}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
