# Ascend CRM settings. On Cloudflare:
#  - plain settings are "vars" in apps/web/wrangler.jsonc (APP_URL, ALLOWED_EMAIL_DOMAIN, MCA_EMAIL_DRY_RUN, …);
#  - secrets go in with `npx wrangler secret put NAME` (or Workers → crm → Settings → Variables).
# Locally: apps/web/.env.local for `next dev`, apps/web/.dev.vars for `cf:preview` (never commit them).
# The database is Cloudflare D1 (binding DB in wrangler.jsonc); no connection string is needed.

# --- Sign-in: Cloudflare Access (Zero Trust → Access → Applications → Ascend CRM) -------------
# Team domain, e.g. "ascendfund.cloudflareaccess.com", and the app's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
# Local `next dev` only: act as this user without Cloudflare Access.
# DEV_USER_EMAIL="jonas@ascendfund.co"

# --- Google Workspace: Gmail + Drive for funding@ (and read-only history from jonas@) --------
# OAuth client (Web application) in an *Internal* Google Cloud project owned by ascendfund.co,
# redirect URI https://crm.dewilarieldiazbonilla.workers.dev/api/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""

# --- AI (Google Gemini by default) -------------------------------------------
# Use a key from a billing-enabled Google Cloud project: free-tier prompts may be used by Google
# to improve its products, which is not acceptable for bank statements.
GEMINI_API_KEY=""
# MCA_AI_PROVIDER="gemini"
# MCA_AI_MODEL_PRIMARY=""
# MCA_AI_MODEL_FAST=""
# ANTHROPIC_API_KEY=""

# --- Secrets ------------------------------------------------------------------
# Encrypts the Google refresh tokens and SSN/DOB/EIN. 32 bytes, base64: openssl rand -base64 32
PII_ENCRYPTION_KEY=""
# Protects /api/cron/tick (the Worker's own cron sends it). openssl rand -hex 32
CRON_SECRET=""

# --- Plain settings (already in wrangler.jsonc "vars"; change there) ----------
# APP_URL="https://crm.dewilarieldiazbonilla.workers.dev"
# ALLOWED_EMAIL_DOMAIN="ascendfund.co"
# TENANT_SLUG="ascend"
# MCA_EMAIL_DRY_RUN="true"      # lender emails only really go out when this is "false"
# INLINE_BUDGET_MS="25000"      # background work right after a click
# TICK_BUDGET_MS="240000"       # each 2-minute scheduled run

# --- WhatsApp applications (built, switched off) -------------------------------
# WHATSAPP_ENABLED="false"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_VERIFY_TOKEN=""
