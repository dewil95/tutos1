# Copy to .env (local) or paste into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Supabase Postgres --------------------------------------------------------
# Runtime: transaction pooler (port 6543). Local docker-compose: the plain URL below.
DATABASE_URL="postgresql://mca:mca@localhost:5432/mca?schema=public"
# Migrations (prisma migrate deploy): direct/session connection (port 5432).
DIRECT_URL="postgresql://mca:mca@localhost:5432/mca?schema=public"
# Keep the per-instance pool small on serverless.
# DB_POOL_MAX=3

# --- Supabase Auth (Google sign-in) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Only these accounts can sign in (they must also exist in the User table; see db:seed).
ALLOWED_EMAIL_DOMAIN="ascendfund.co"
# Public URL of the app (defaults to the request origin).
# APP_URL="https://your-app.vercel.app"

# --- Google Workspace: Gmail + Drive for funding@ -----------------------------
# OAuth client (Web application) in an *Internal* Google Cloud project owned by ascendfund.co.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to <APP_URL>/api/google/callback; must match the OAuth client's redirect URI.
# GOOGLE_REDIRECT_URI=""

# --- Sending ------------------------------------------------------------------
# Lender emails are only really sent when this is "false". Anything else writes the composed
# email to the deal timeline instead (safe default for local and preview deployments).
MCA_EMAIL_DRY_RUN="true"
# Used by db:seed for the tenant: sending address and team copied on every submission.
MAIL_FROM="funding@ascendfund.co"
TEAM_CC="jonas@ascendfund.co,savvy@ascendfund.co,david@ascendfund.co"

# --- AI (Google Gemini by default) -------------------------------------------
# Use a key from a billing-enabled Google Cloud project: free-tier prompts may be used by Google
# to improve its products, which is not acceptable for bank statements.
MCA_AI_PROVIDER="gemini"
GEMINI_API_KEY=""
# Optional overrides (defaults: gemini-3.1-pro-preview / gemini-3-flash-preview)
# MCA_AI_MODEL_PRIMARY=""
# MCA_AI_MODEL_FAST=""
# Optional alternative provider: MCA_AI_PROVIDER="anthropic" + ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=""

# --- Secrets ------------------------------------------------------------------
# Shared secret Supabase Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/tick.
# Generate: openssl rand -hex 32
CRON_SECRET=""
# Encrypts the Google refresh token and PII fields. 32 bytes, base64: openssl rand -base64 32
PII_ENCRYPTION_KEY=""
