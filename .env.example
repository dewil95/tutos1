# Ascend CRM settings for running it on your own machine (`pnpm --filter @mca/web dev`):
# copy this file to apps/web/.env.local and fill it in (never commit it). On the server the
# same settings live in /etc/ascend-crm/env (see deploy/oracle/env.example).

# --- Database: a SQLite file (create it with `DATABASE_PATH=... pnpm db:migrate`) -----------
DATABASE_PATH=""

# --- Sign-in: Cloudflare Access (Zero Trust → Access → Applications → Ascend CRM) -------------
# Team domain, e.g. "ascendfund.cloudflareaccess.com", and the app's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
# Local `next dev` only: act as this user without Cloudflare Access.
# DEV_USER_EMAIL="jonas@ascendfund.co"

# --- Google Workspace: Gmail + Drive for funding@ (and read-only history from jonas@) --------
# OAuth client (Web application) in an *Internal* Google Cloud project owned by ascendfund.co,
# redirect URI https://crm.ascendfund.co/api/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""

# --- AI (Google Gemini by default) -------------------------------------------
# Use a key from a billing-enabled Google Cloud project: free-tier prompts may be used by Google
# to improve its products, which is not acceptable for bank statements.
GEMINI_API_KEY=""
# MCA_AI_PROVIDER="gemini"
# MCA_AI_MODEL_PRIMARY=""
# MCA_AI_MODEL_FAST=""
# ANTHROPIC_API_KEY=""

# --- Secrets ------------------------------------------------------------------
# Encrypts the Google refresh tokens and SSN/DOB/EIN. 32 bytes, base64: openssl rand -base64 32
PII_ENCRYPTION_KEY=""
# Protects /api/cron/tick (the server's timer sends it). openssl rand -hex 32
CRON_SECRET=""

# --- Plain settings ------------------------------------------------------------
# APP_URL="https://crm.ascendfund.co"
# ALLOWED_EMAIL_DOMAIN="ascendfund.co"
# TENANT_SLUG="ascend"
# MCA_EMAIL_DRY_RUN="true"      # lender emails only really go out when this is "false"
# INLINE_BUDGET_MS="60000"      # background work right after a click
# TICK_BUDGET_MS="100000"       # each 2-minute scheduled run

# --- WhatsApp applications (built, switched off) -------------------------------
# WHATSAPP_ENABLED="false"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_VERIFY_TOKEN=""
