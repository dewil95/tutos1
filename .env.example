# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose default)
DATABASE_URL="postgresql://mca:mca@localhost:5432/mca?schema=public"

# Redis (docker-compose default)
REDIS_URL="redis://localhost:6379"

# Anthropic Claude API
ANTHROPIC_API_KEY=""
# Override models if needed (defaults: claude-opus-5-5 / claude-haiku-4-5)
# MCA_AI_MODEL_PRIMARY="claude-opus-5-5"
# MCA_AI_MODEL_FAST="claude-haiku-4-5"

# Object storage (MinIO in docker-compose; any S3-compatible store in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="mca-documents"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio12345"

# Auth.js
AUTH_SECRET="change-me-32-bytes-min"
AUTH_URL="http://localhost:3000"

# Field-level encryption key for SSN/DOB (32 bytes, base64)
PII_ENCRYPTION_KEY=""

# Twilio (phase 2)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
