{
  // Ascend CRM on Cloudflare Workers (Next.js through @opennextjs/cloudflare).
  // Deploy: .github/workflows/deploy.yml (or `pnpm --filter @mca/web cf:deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ascend-crm",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Only reachable through crm.ascendfund.co, which sits behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "crm.ascendfund.co", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ascend-crm",
      // Filled in by the deploy workflow from `wrangler d1 list`; any value works locally.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Background work: inbox check, sends, statement reading, reminders.
  "triggers": { "crons": ["*/2 * * * *"] },
  "limits": { "cpu_ms": 120000 },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://crm.ascendfund.co",
    "ALLOWED_EMAIL_DOMAIN": "ascendfund.co",
    "TENANT_SLUG": "ascend",
    "MCA_EMAIL_DRY_RUN": "true",
    "WHATSAPP_ENABLED": "false",
    "INLINE_BUDGET_MS": "25000",
    "TICK_BUDGET_MS": "240000",
  },
}
